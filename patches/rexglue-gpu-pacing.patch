+void DeferredCommandBuffer::ShrinkRenderArea() {
+  size_t begin = pass_begin_offset_;
+  pass_begin_offset_ = SIZE_MAX;
+  if (begin == SIZE_MAX || begin >= command_stream_.Size() ||
+      !command_processor_.GetVulkanSettings().shrink_render_area.Get()) {
+    return;
+  }
+  uintmax_t* stream = command_stream_.MutableData();
+  const auto& begin_header = *reinterpret_cast<const CommandHeader*>(stream + begin);
+  uintmax_t* begin_args = stream + begin + kCommandHeaderSizeElements;
+  VkRect2D* render_area;
+  if (begin_header.command == Command::kVkBeginRendering) {
+    auto& args = *reinterpret_cast<ArgsVkBeginRendering*>(begin_args);
+    const auto* attachments = reinterpret_cast<const VkRenderingAttachmentInfo*>(
+        reinterpret_cast<const u8*>(begin_args) +
+        rex::RoundUpPow2(sizeof(ArgsVkBeginRendering), alignof(VkRenderingAttachmentInfo)));
+    u32 attachment_count = args.color_attachment_count + u32(args.has_depth_attachment) +
+                           u32(args.has_stencil_attachment);
+    for (u32 i = 0; i < attachment_count; ++i) {
+      // A clear load op and an MSAA resolve both cover the whole render area: keep it whole.
+      if (attachments[i].resolveMode != VK_RESOLVE_MODE_NONE ||
+          attachments[i].loadOp == VK_ATTACHMENT_LOAD_OP_CLEAR) {
+        return;
+      }
+    }
+    render_area = &args.render_area;
+  } else if (begin_header.command == Command::kVkBeginRenderPass) {
+    auto& args = *reinterpret_cast<ArgsVkBeginRenderPass*>(begin_args);
+    // Clear values mean load op clears in the render pass object, which cover the render area.
+    if (args.clear_value_count) {
+      return;
+    }
+    render_area = &args.render_area;
+  } else {
+    return;
+  }
+  // Bounding box of everything the pass writes.
+  i64 x0 = INT64_MAX, y0 = INT64_MAX, x1 = INT64_MIN, y1 = INT64_MIN;
+  auto add = [&](const VkRect2D& r) {
+    x0 = std::min<i64>(x0, r.offset.x);
+    y0 = std::min<i64>(y0, r.offset.y);
+    x1 = std::max<i64>(x1, i64(r.offset.x) + r.extent.width);
+    y1 = std::max<i64>(y1, i64(r.offset.y) + r.extent.height);
+  };
+  VkRect2D scissor = pass_begin_scissor_;
+  bool scissor_valid = pass_begin_scissor_valid_;
+  size_t pos = begin;
+  while (pos < command_stream_.Size()) {
+    const auto& header = *reinterpret_cast<const CommandHeader*>(stream + pos);
+    const u8* args = reinterpret_cast<const u8*>(stream + pos + kCommandHeaderSizeElements);
+    switch (header.command) {
+      case Command::kVkSetScissor: {
+        const auto& a = *reinterpret_cast<const ArgsVkSetScissor*>(args);
+        if (a.first_scissor == 0 && a.scissor_count) {
+          scissor = *reinterpret_cast<const VkRect2D*>(
+              args + rex::RoundUpPow2(sizeof(ArgsVkSetScissor), alignof(VkRect2D)));
+          scissor_valid = true;
+        }
+      } break;
+      case Command::kVkDraw:
+      case Command::kVkDrawIndexed:
+        if (!scissor_valid) {
+          return;  // An unbounded draw: keep the full area.
+        }
+        add(scissor);
+        break;
+      case Command::kVkClearAttachments: {
+        const auto& a = *reinterpret_cast<const ArgsVkClearAttachments*>(args);
+        size_t rects_offset = rex::RoundUpPow2(
+            rex::RoundUpPow2(sizeof(ArgsVkClearAttachments), alignof(VkClearAttachment)) +
+                sizeof(VkClearAttachment) * a.attachment_count,
+            alignof(VkClearRect));
+        const auto* rects = reinterpret_cast<const VkClearRect*>(args + rects_offset);
+        for (u32 i = 0; i < a.rect_count; ++i) {
+          add(rects[i].rect);
+        }
+      } break;
+      default:
+        break;
+    }
+    pos += kCommandHeaderSizeElements + header.arguments_size_elements;
+  }
+  if (x0 >= x1 || y0 >= y1) {
+    return;  // Nothing written: leave the pass as recorded.
+  }
+  i64 ax0 = render_area->offset.x, ay0 = render_area->offset.y;
+  i64 ax1 = ax0 + render_area->extent.width, ay1 = ay0 + render_area->extent.height;
+  x0 = std::max(x0, ax0);
+  y0 = std::max(y0, ay0);
+  x1 = std::min(x1, ax1);
+  y1 = std::min(y1, ay1);
+  if (x0 >= x1 || y0 >= y1) {
+    return;
+  }
+  render_area->offset.x = i32(x0);
+  render_area->offset.y = i32(y0);
+  render_area->extent.width = u32(x1 - x0);
+  render_area->extent.height = u32(y1 - y0);
+}
