+void VulkanSharedMemory::OnRangesRequested(const std::vector<std::pair<u32, u32>>& ranges) {
+  draw_reads_.insert(draw_reads_.end(), ranges.begin(), ranges.end());
+}
+
+void VulkanSharedMemory::CommitDrawReads() {
+  for (const std::pair<u32, u32>& range : draw_reads_) {
+    // Merge with the previous range when contiguous or overlapping (streamed vertices).
+    if (!pass_reads_.empty()) {
+      std::pair<u32, u32>& last = pass_reads_.back();
+      u64 last_end = u64(last.first) + last.second;
+      if (range.first >= last.first && range.first <= last_end) {
+        last.second = u32(std::max(last_end, u64(range.first) + range.second) - last.first);
+        continue;
+      }
+    }
+    pass_reads_.push_back(range);
+  }
+  draw_reads_.clear();
+}
+
+bool VulkanSharedMemory::OverlapsPassReads(
+    const std::vector<std::pair<u32, u32>>& upload_page_ranges) const {
+  for (const std::pair<u32, u32>& upload : upload_page_ranges) {
+    u64 start = u64(upload.first) << GetPageSizeLog2();
+    u64 end = start + (u64(upload.second) << GetPageSizeLog2());
+    for (const std::pair<u32, u32>& read : pass_reads_) {
+      if (read.first < end && start < u64(read.first) + read.second) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
