diff --git a/src/gpu/xenos/gpu_stats.h b/src/gpu/xenos/gpu_stats.h
new file mode 100644
index 0000000..0365132
--- /dev/null
+++ b/src/gpu/xenos/gpu_stats.h
@@ -0,0 +1,58 @@
+/**
+ * @file        gpu/xenos/gpu_stats.h
+ *
+ * @brief       Per-frame GPU work counters for performance investigation (gpu.xenos.stats_log).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <atomic>
+
+#include <rex/types.h>
+
+namespace rex::gpu {
+
+/**
+ * Counts of the work the Xenos emulation does. Relaxed atomic adds, always on; the command
+ * processor logs averages per frame every few seconds when gpu.xenos.stats_log is set. The base
+ * library is linked into each driver module, so each module has its own copy, and only one
+ * driver runs.
+ */
+struct GpuStats {
+  std::atomic<u64> draws{0};               // host draws issued
+  std::atomic<u64> resolves{0};            // guest resolves (copies out of EDRAM)
+  std::atomic<u64> resolve_readbacks{0};   // resolves written back to guest memory by the CPU
+  std::atomic<u64> rt_updates{0};          // render target binding changes with transfers checked
+  std::atomic<u64> edram_transfers{0};     // EDRAM ownership transfers between host targets
+  std::atomic<u64> resolve_clears{0};      // render targets cleared by a resolve
+  std::atomic<u64> render_passes{0};       // host render passes begun
+  std::atomic<u64> upload_ranges{0};       // shared memory page ranges uploaded
+  std::atomic<u64> upload_bytes{0};        // shared memory bytes uploaded
+  std::atomic<u64> uploads_hoisted{0};     // uploads moved before the open render pass (Vulkan)
+  std::atomic<u64> textures_loaded{0};     // textures (re)loaded from guest memory
+  std::atomic<u64> pipelines_created{0};   // host pipelines created
+  std::atomic<u64> submissions{0};         // host command buffer submissions
+
+  // Frame pacing (gpu.xenos.pacing_log), host ticks.
+  std::atomic<u64> vblanks{0};             // guest vblank interrupts delivered
+  std::atomic<u64> vblank_late{0};         // vblanks more than 18 ms after the previous one
+  std::atomic<u64> vblank_max_gap{0};      // longest vblank gap since the last log, host ticks
+  std::atomic<u64> vblank_holds{0};        // vblanks held for a late frame (late_frame_vblank)
+  std::atomic<u64> vblank_hold_ticks{0};   // ... and the guest ticks they were held
+  std::atomic<u64> vblank_hold_timeouts{0};  // ... of which released by the one-refresh limit
+  std::atomic<u64> wrm_waits{0};           // WAIT_REG_MEM packets that had to wait
+  std::atomic<u64> wrm_wait_ticks{0};      // host ticks spent waiting in WAIT_REG_MEM
+  std::atomic<u64> wrm_vblank_waits{0};    // ... of which on a memory address (not a register)
+  std::atomic<u64> wrm_vblank_ticks{0};    // ... and their ticks
+
+  void Add(std::atomic<u64>& counter, u64 value = 1) {
+    counter.fetch_add(value, std::memory_order_relaxed);
+  }
+};
+
+inline GpuStats g_gpu_stats;
+
+}  // namespace rex::gpu
