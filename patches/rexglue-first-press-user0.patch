+
+// first_press_is_user0: only user 0 has the signed-in profile, so a player whose pad sits in a
+// later slot (an idle second pad took slot 0) cannot save. Until some input arrives, every call
+// checks all pads; the first pad with input takes ordinal 0 and the pad that held it takes the
+// freed ordinal. Runs before the read in the same call, so the game sees that press on user 0.
+// Settles once per session: later presses (a versus opponent) never reshuffle.
+void InputSystem::State::ClaimUser0Locked(std::vector<ConnectionEvent>& events) {
+  if (user0_claimed) {
+    return;
+  }
+  const auto& settings = owner.GetSettings();
+  if (!settings.first_press_is_user0.Get() || settings.shared_pads.Get()) {
+    user0_claimed = true;
+    return;
+  }
+  detail::Device* first = nullptr;
+  for (detail::Device& device : devices) {
+    // Keyboard and mouse always feed user 0 and never claim: a mouse moved over the window
+    // first must not settle the slots before the player's pad is used.
+    if (!device.counts || device.synthetic) {
+      continue;
+    }
+    auto state = sources[device.key.source]->GetDeviceState(device.key.id);
+    if (state && !detail::IsNeutral(*state)) {
+      first = &device;
+      break;
+    }
+  }
+  if (!first) {
+    return;
+  }
+  user0_claimed = true;
+  if (first->ordinal == 0) {
+    return;
+  }
+  const u32 freed = first->ordinal;
+  for (detail::Device& device : devices) {
+    if (!device.synthetic && device.ordinal == 0) {
+      device.ordinal = freed;
+    }
+  }
+  first->ordinal = 0;
+  REXHID_INFO("Controller in user {} pressed first; it is user 0 now, user 0's pad moves to {}.",
+              freed, freed);
+  // Per-user input state follows its pad. The packet number changes by itself: the device
+  // signature of both users changes, so the next read of each counts as a new packet.
+  std::swap(consumed[0], consumed[freed]);
+  std::swap(synth[0], synth[freed]);
+  std::swap(last_state[0], last_state[freed]);
+  std::ranges::stable_sort(devices, [](const detail::Device& a, const detail::Device& b) {
+    return a.ordinal < b.ordinal;
+  });
+  users = detail::AssignUsers(devices, settings.shared_pads.Get());
+  UpdateConnectionsLocked(events);
 }
 
