+// [blitz diagnostics] Logs one snapshot per stall, from a plain host thread so it still reports
+// when the worker is stuck inside a guest callback.
+void APU::DiagWatchdogMain() {
+  for (;;) {
+    {
+      std::unique_lock lock(diag_mutex_);
+      if (diag_wake_.wait_for(lock, std::chrono::milliseconds(250), [this] { return diag_stop_; })) {
+        return;
+      }
+    }
+    if (paused_) {
+      continue;
+    }
+    const i64 limit_ms = audio_ ? audio_->GetSettings().diag_starve_ms.Get() : 2000;
+    const i64 now = DiagNowMs();
+    for (u32 i = 0; i < kMaxClients; ++i) {
+      ClientDiag& d = diag_[i];
+      const u64 submits = d.submits.load();
+      const i64 last = d.last_submit_ms.load();
+      if (submits == 0 || last == 0) {
+        continue;
+      }
+      const i64 quiet = now - last;
+      if (quiet < limit_ms) {
+        if (d.reported) {
+          d.reported = false;
+          REXAPU_WARN("audio diag: client {} is submitting frames again after {} submits", i,
+                      submits);
+        }
+        continue;
+      }
+      if (d.reported) {
+        continue;
+      }
+      d.reported = true;
+      const u64 wakes = d.wakes.load();
+      const i64 credits = static_cast<i64>(d.initial_credits.load()) +
+                          static_cast<i64>(d.credits_released.load()) - static_cast<i64>(wakes);
+      const i64 in_cb = worker_in_callback_ms_.load();
+      const i32 cb_client = worker_callback_client_.load();
+      std::string worker;
+      const char* verdict;
+      if (!worker_running_) {
+        worker = "not running";
+        verdict = "the audio worker has stopped";
+      } else if (in_cb != 0) {
+        worker = std::format("inside the guest callback of client {} for {} ms", cb_client,
+                             now - in_cb);
+        verdict = "a guest audio callback is blocked";
+      } else {
+        const i64 woke = worker_last_wake_ms_.load();
+        worker = woke ? std::format("waiting, last woke {} ms ago", now - woke)
+                      : std::string("waiting, never woke");
+        verdict = credits <= 0 ? "credits leaked: callbacks returned without submitting"
+                               : "the worker holds credits but is not waking";
+      }
+      REXAPU_WARN(
+          "audio diag: client {} has submitted no frames for {} ms ({}). submits {}, refused {}; "
+          "credits: start {} + returned {} (dropped at max {}) - taken {} = {}; callbacks done {}, "
+          "{} without a submit; worker {}; last submit from guest thread {:08X}",
+          i, quiet, verdict, submits, d.refused.load(), d.initial_credits.load(),
+          d.credits_released.load(), d.credits_full.load(), wakes, credits,
+          d.callbacks_done.load(), d.empty_callbacks.load(), worker, d.last_submit_thread.load());
+    }
+  }
+}
