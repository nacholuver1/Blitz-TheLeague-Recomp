+  // [blitz diagnostics] Audio starve snapshot. Counters per client, written lock-free by the mixer
+  // thread (credits), the worker (wakes, callbacks) and the submitting guest thread (submits). A
+  // host watchdog thread, independent of the worker, logs one snapshot when a client that was
+  // submitting has submitted nothing for 2 s, and one line when it submits again.
+  struct ClientDiag {
+    std::atomic<u64> credits_released{0};  // mixer: a played frame gave a credit back
+    std::atomic<u64> credits_full{0};      // mixer: the credit was dropped, semaphore at its max
+    std::atomic<u64> wakes{0};             // worker: took a credit for this client
+    std::atomic<u64> callbacks_done{0};    // worker: the guest callback returned
+    std::atomic<u64> empty_callbacks{0};   // worker: the callback returned without a submit
+    std::atomic<u64> submits{0};           // SubmitFrame calls that reached the stream
+    std::atomic<u64> refused{0};           // submits the audio system refused (queue full)
+    std::atomic<i64> last_submit_ms{0};    // steady-clock ms of the last submit
+    std::atomic<u32> last_submit_thread{0};
+    std::atomic<u32> initial_credits{0};
+    std::atomic<bool> reported{false};
+    void Reset() {
+      credits_released = 0;
+      credits_full = 0;
+      wakes = 0;
+      callbacks_done = 0;
+      empty_callbacks = 0;
+      submits = 0;
+      refused = 0;
+      last_submit_ms = 0;
+      last_submit_thread = 0;
+      initial_credits = 0;
+      reported = false;
+    }
+  };
+  void DiagWatchdogMain();
+  void StopDiagWatchdog();
+  std::array<ClientDiag, kMaxClients> diag_{};
+  std::atomic<i64> worker_in_callback_ms_{0};  // 0 = worker not inside a guest callback
+  std::atomic<i32> worker_callback_client_{-1};
+  std::atomic<i64> worker_last_wake_ms_{0};
+  std::thread diag_thread_;
+  std::mutex diag_mutex_;
+  std::condition_variable diag_wake_;
